generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum PropertyStatus {
  FOR_SALE
  FOR_RENT
  SOLD
  RENTED
}

enum PublicationState {
  DRAFT
  PUBLISHED
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @db.VarChar(160)
  email            String           @unique @db.VarChar(320)
  passwordHash     String
  role             Role             @default(USER)
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  createdProperties Property[]       @relation("PropertyCreatedBy")
  updatedProperties Property[]       @relation("PropertyUpdatedBy")
  refreshSessions  RefreshSession[]
  updatedSettings  SystemSettings[] @relation("SettingsUpdatedBy")
}

model Category {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique @db.VarChar(80)
  slug       String     @unique @db.VarChar(100)
  properties Property[]
}

model Property {
  id               String           @id @default(uuid()) @db.Uuid
  code             String           @unique @db.VarChar(20)
  slug             String           @unique @db.VarChar(240)
  title            String           @db.VarChar(200)
  description      String
  price            Decimal          @db.Decimal(14, 2)
  status           PropertyStatus
  publicationState PublicationState @default(DRAFT)
  categoryId       String           @db.Uuid
  zipCode          String           @db.Char(8)
  street           String           @db.VarChar(200)
  number           String           @db.VarChar(30)
  complement       String?          @db.VarChar(120)
  neighborhood     String           @db.VarChar(120)
  city             String           @db.VarChar(120)
  state            String           @db.Char(2)
  country          String           @default("Brasil") @db.VarChar(80)
  latitude         Decimal?         @db.Decimal(10, 7)
  longitude        Decimal?         @db.Decimal(10, 7)
  whatsappNumber   String           @db.VarChar(20)
  createdBy        String           @db.Uuid
  updatedBy        String           @db.Uuid
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?        @db.Timestamptz(6)
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator          User             @relation("PropertyCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater          User             @relation("PropertyUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
  images           PropertyImage[]

  @@index([status, createdAt])
  @@index([categoryId, city, neighborhood])
  @@index([deletedAt, publicationState])
}

model PropertyImage {
  id               String   @id @default(uuid()) @db.Uuid
  propertyId       String   @db.Uuid
  objectKey        String
  bucket           String   @db.VarChar(120)
  originalFilename String   @db.VarChar(255)
  mimeType         String   @db.VarChar(80)
  size             BigInt
  isPrimary        Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([bucket, objectKey])
  @@index([propertyId, sortOrder])
}

model SystemSettings {
  id                    Int       @id @default(1)
  defaultWhatsappNumber String    @db.VarChar(20)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)
  updatedBy             String?   @db.Uuid
  updater               User?     @relation("SettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  familyId   String    @db.Uuid
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt DateTime? @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([familyId])
}

model LoginRateLimit {
  key       String   @id @db.VarChar(512)
  count     Int      @default(0)
  expiresAt DateTime @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([expiresAt])
}
